<Window x:Class="SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar Atalhos de Teclado"
        Height="620" Width="520" MinHeight="450" MinWidth="450"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="CanResize"
        Background="#FFF5F5F7"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextElement.Foreground="#FF1D1D1F">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Atalhos de teclado"
                   FontSize="18" FontWeight="SemiBold" Foreground="#FF1D1D1F"
                   Margin="0,0,0,14"/>

        <!-- Lista de atalhos (cartão) -->
        <Border Grid.Row="1" Background="White" BorderBrush="#FFE5E5EA" BorderThickness="1" CornerRadius="10" VerticalAlignment="Top">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho da lista -->
            <Border Grid.Row="0" BorderBrush="#FFE5E5EA" BorderThickness="0,0,0,1" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Ação" FontSize="11" FontWeight="SemiBold" Foreground="#FF86868B"/>
                    <TextBlock Grid.Column="1" Text="Tecla de atalho" FontSize="11" FontWeight="SemiBold" Foreground="#FF86868B" MinWidth="140" TextAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Linhas de configuração -->
            <ItemsControl Grid.Row="1" x:Name="listaAtalhos" BorderThickness="0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14,0" BorderBrush="#FFF2F2F7" BorderThickness="0,0,0,1" Background="White">
                            <Grid MinHeight="42">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding NomeExibicao}" VerticalAlignment="Center" Foreground="#FF1D1D1F" FontSize="13"/>

                                <Border Grid.Column="1" MinWidth="140" Height="30" Margin="0,6"
                                        Background="#FFF2F2F7" CornerRadius="8"
                                        BorderBrush="Transparent" BorderThickness="1"
                                        Cursor="Hand" Tag="{Binding}"
                                        ToolTip="Clique e pressione a tecla desejada">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FFE8E8ED"/>
                                                    <Setter Property="BorderBrush" Value="#FF007AFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock x:Name="txtTecla" Text="{Binding TeclaExibicao}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Foreground="#FF007AFF" FontWeight="SemiBold" FontSize="13"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
        </Border>

        <!-- Botões inferiores -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Name="btnRestaurarPadroes" Content="Restaurar padrões" Style="{StaticResource BotaoArredondado}" Padding="14,7" FontSize="13"
                    Click="BtnRestaurarPadroes_Click" Margin="0,0,8,0"/>
            <Button Name="btnCancelar" Content="Cancelar" Style="{StaticResource BotaoArredondado}" Padding="14,7" FontSize="13"
                    Click="BtnCancelar_Click" Margin="0,0,8,0"/>
            <Button Name="btnSalvar" Content="Salvar" Style="{StaticResource BotaoPrimario}" Padding="18,7" FontSize="13" Click="BtnSalvar_Click"/>
        </StackPanel>

        <!-- Dica -->
        <TextBlock Grid.Row="2" Text="Clique no campo da tecla e pressione a tecla desejada."
                   FontSize="11" Foreground="#FF86868B" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,16,0,0"/>
    </Grid>
</Window>
