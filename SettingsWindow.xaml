<Window x:Class="SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar Atalhos de Teclado"
        Height="620" Width="520" MinHeight="450" MinWidth="450"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="CanResize"
        Background="{StaticResource CorFundoJanela}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextElement.Foreground="{StaticResource CorTexto}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Atalhos de teclado"
                   FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource CorTexto}"
                   Margin="0,0,0,14"/>

        <!-- Lista de atalhos (cartão) -->
        <!-- Cartão ocupa a altura disponível; a lista rola quando não cabe -->
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho da lista -->
            <Border Grid.Row="0" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,0,1" Padding="14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Ação" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CorTextoSecundario}"/>
                    <TextBlock Grid.Column="1" Text="Tecla de atalho" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CorTextoSecundario}" MinWidth="140" TextAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Linhas de configuração -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,6">
            <ItemsControl x:Name="listaAtalhos" BorderThickness="0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="14,0" BorderBrush="{StaticResource CorFundoCinza}" BorderThickness="0,0,0,1" Background="White">
                            <Grid MinHeight="42">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding NomeExibicao}" VerticalAlignment="Center" Foreground="{StaticResource CorTexto}" FontSize="13"/>

                                <Border Grid.Column="1" MinWidth="140" Height="30" Margin="0,6"
                                        Background="{StaticResource CorFundoCinza}" CornerRadius="8"
                                        BorderBrush="Transparent" BorderThickness="1"
                                        Cursor="Hand" Tag="{Binding}"
                                        ToolTip="Clique e pressione a tecla desejada">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FFE8E8ED"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource CorAzul}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock x:Name="txtTecla" Text="{Binding TeclaExibicao}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource CorAzul}" FontWeight="SemiBold" FontSize="13"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </Grid>
        </Border>

        <!-- Dica (linha própria, logo abaixo da lista: não disputa espaço com os botões) -->
        <TextBlock Grid.Row="2" Text="Clique no campo da tecla e pressione a tecla desejada."
                   FontSize="11" Foreground="{StaticResource CorTextoSecundario}" TextWrapping="Wrap" Margin="4,8,0,0"/>

        <!-- Botões inferiores: Restaurar à esquerda, Cancelar/Salvar à direita -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Name="btnRestaurarPadroes" Grid.Column="0" Content="Restaurar padrões" Style="{StaticResource BotaoArredondado}" Padding="14,7" FontSize="13"
                    Click="BtnRestaurarPadroes_Click"/>
            <Button Name="btnCancelar" Grid.Column="2" Content="Cancelar" Style="{StaticResource BotaoArredondado}" Padding="14,7" FontSize="13"
                    Click="BtnCancelar_Click" Margin="0,0,8,0"/>
            <Button Name="btnSalvar" Grid.Column="3" Content="Salvar" Style="{StaticResource BotaoPrimario}" Padding="18,7" FontSize="13" Click="BtnSalvar_Click"/>
        </Grid>
    </Grid>
</Window>
