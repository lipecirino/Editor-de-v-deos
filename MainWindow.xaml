<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor de Vídeo (Padronização)" 
        Height="750" Width="1050" MinHeight="650" MinWidth="850"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="BotaoArredondado" TargetType="Button">
            <Setter Property="Background" Value="#FF033150"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderYoutube" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="4" Background="#33FFFFFF" VerticalAlignment="Center" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton>
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#FFFF0000" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="bolinha" Width="12" Height="12" Fill="#FF888888" Margin="-1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoArredondadoToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#FF033150"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProgressLote" TargetType="ProgressBar">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="#FFFF0000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid Height="6">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="3"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="GALERIA (Arraste seu Vídeo aqui)" FontWeight="Bold" Foreground="#888" Margin="0,0,0,10"/>
            <ListBox Name="lstGaleria" Grid.Row="1" SelectionChanged="LstGaleria_SelectionChanged" BorderThickness="0" Background="#F9F9F9" AllowDrop="True" Drop="LstGaleria_Drop" MouseRightButtonUp="LstGaleria_MouseRightButtonUp">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="✓ Marcar/Desmarcar Cronoanálise" Click="ToggleCronoAnaliseFlag_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <Button Content="+ Video" Click="BtnAbrirArquivos_Click" Style="{StaticResource BotaoArredondado}" Height="35" Margin="0,0,0,5" Background="#444"/>
                <Button Content="+ Pasta" Click="BtnAbrirPasta_Click" Style="{StaticResource BotaoArredondado}" Height="35" Margin="0,0,0,5" Background="#444"/>
                <Button Content="Limpar" Click="BtnLimpar_Click" Style="{StaticResource BotaoArredondado}" Height="35" Background="#FFA90C0C"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" x:Name="gridConteudo">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*" MinHeight="170"/>
            </Grid.RowDefinitions>

            <!-- ===== TOPO: Vídeo + Controlos ===== -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="Black" CornerRadius="10">
                <Grid>
                    <MediaElement Name="VisualizadorVideo" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" MediaOpened="VisualizadorVideo_MediaOpened"/>
                    <Image Name="imgFrameBuffer" Stretch="Uniform" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,15,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Name="btnFrameAnterior" Content="⏮" Width="45" Height="35" Style="{StaticResource BotaoArredondado}" Click="BtnFrameAnterior_Click" ToolTip="Frame Anterior (Seta Esquerda)"/>
                <Button Name="btnPlayPause" Content="▶" Width="45" Height="35" Style="{StaticResource BotaoArredondado}" Click="BtnPlayPause_Click" Grid.Column="1" Margin="5,0,0,0"/>
                <Button Name="btnFrameProximo" Content="⏭" Width="45" Height="35" Style="{StaticResource BotaoArredondado}" Click="BtnFrameProximo_Click" Grid.Column="2" Margin="5,0,0,0" ToolTip="Próximo Frame (Seta Direita)"/>
                <ToggleButton Name="btnModoCrono" Content="⏱ Crono" Width="85" Height="35" Grid.Column="3" Margin="8,0,0,0"
                              Style="{StaticResource BotaoArredondadoToggle}" Background="#FF6A4C93"
                              Checked="BtnModoCrono_Checked" Unchecked="BtnModoCrono_Unchecked"
                              ToolTip="Ativar/Desativar Modo Cronoanálise"/>
                <TextBlock Name="lblTempoAtual" Text="00:00:00" Grid.Column="4" VerticalAlignment="Center" Margin="15,0" Foreground="#666"/>

                <Grid Grid.Column="5" Name="gridSliderCorte" SizeChanged="GridSliderCorte_SizeChanged">

                    <Slider Name="slLinhaTempo" Style="{StaticResource SliderYoutube}" 
                            Thumb.DragStarted="SlLinhaTempo_DragStarted" 
                            Thumb.DragCompleted="SlLinhaTempo_DragCompleted"
                            ValueChanged="SlLinhaTempo_ValueChanged"
                            Panel.ZIndex="1"/>

                    <Canvas Name="canvasCorte" IsHitTestVisible="False" VerticalAlignment="Center" Height="16" Margin="6,0,6,0" Panel.ZIndex="2">
                        <Border Name="bdrCorte" Height="16" BorderBrush="Black" BorderThickness="4,1,4,1" Background="Transparent" Visibility="Hidden" CornerRadius="2"/>
                    </Canvas>

                    <Popup Name="popupTempoDrag" Placement="Mouse" AllowsTransparency="True" IsOpen="False" Panel.ZIndex="3">
                        <Border Background="#CC000000" CornerRadius="5" Padding="8,4">
                            <TextBlock Name="lblTempoDrag" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        </Border>
                    </Popup>
                </Grid>
                <TextBlock Name="lblTempoTotal" Text="00:00:00" Grid.Column="6" VerticalAlignment="Center" Margin="15,0" Foreground="#666"/>
            </Grid>  <!-- fecha barra de controlos -->
            </Grid>  <!-- fecha wrapper topo (video + controlos) -->

            <!-- ===== SEPARADOR ===== -->
            <GridSplitter Name="gridSplitterCrono" Grid.Row="1" Height="8" HorizontalAlignment="Stretch"
                          VerticalAlignment="Center" Background="#FFE2E8F0" ShowsPreview="True"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          ToolTip="Arraste para ajustar a altura da área inferior"/>

            <!-- ===== INFERIOR: Config Video / Exportação OU Cronoanálise ===== -->
            <Grid Grid.Row="2" x:Name="gridInferior" Margin="0,0,0,10">

                <!-- Painel de Config + Export (modo normal) -->
                <StackPanel Name="painelConfigCompleto">
                    <GroupBox Name="grpConfigVideo" Header="Configurações do Vídeo" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="Corte (seg):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Name="txtInicio" Width="50" Text="0" VerticalAlignment="Center" TextChanged="TxtCorte_TextChanged"/>
                            <Button Content="Fixar Início" Click="BtnCapturarInicio_Click" Margin="5,0,20,0" Padding="10,2" Style="{StaticResource BotaoArredondado}" Background="#666" FontSize="11"/>
                            <TextBox Name="txtFim" Width="50" Text="0" VerticalAlignment="Center" TextChanged="TxtCorte_TextChanged"/>
                            <Button Content="Fixar Fim" Click="BtnCapturarFim_Click" Margin="5,0,0,0" Padding="10,2" Style="{StaticResource BotaoArredondado}" Background="#666" FontSize="11"/>
                        </StackPanel>
                        <WrapPanel>
                            <RadioButton Name="rbNormal" Content="Normal" IsChecked="True" Margin="0,0,15,0"/>
                            <RadioButton Name="rbRotDireita" Content="Girar 90° D" Margin="0,0,15,0"/>
                            <RadioButton Name="rbRotEsquerda" Content="Girar 90° E" Margin="0,0,15,0"/>
                            <RadioButton Name="rbRot180" Content="180°" Margin="0,0,15,0"/>
                            <RadioButton Name="rbEspelharH" Content="Espelhar H" Margin="0,0,15,0"/>
                            <RadioButton Name="rbEspelharV" Content="Espelhar V"/>
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <StackPanel Name="painelExportacao" Margin="0,0,0,10">
                    <Expander Name="expExportacaoDesempenho" Header="Exportação e Desempenho (Clique para expandir)" Margin="0,0,0,15" IsExpanded="False" Background="#F0F0F0" Padding="10" BorderBrush="#DDD" BorderThickness="1">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Local de Guardar:" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton Name="rbSalvarPastaEscolhida" Content="Escolher uma pasta" IsChecked="True" Margin="0,0,15,0"/>
                                <RadioButton Name="rbSalvarPastaOriginal" Content="Guardar na mesma pasta do original (adiciona '_editado')"/>
                            </StackPanel>

                            <CheckBox Name="chkDeletarOriginal" Content="Eliminar vídeo original após a conversão com sucesso" Margin="0,0,0,15"/>

                            <TextBlock Text="Uso de Processador (CPU):" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Name="rbDesempenhoAlto" Content="Alto Desempenho (Sem limites)" IsChecked="True" Margin="0,0,15,0"/>
                                <RadioButton Name="rbDesempenhoEco" Content="Modo Económico (Limitar a 50% para não bloquear o PC)"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <StackPanel Name="painelProgresso" Visibility="Collapsed" Margin="0,0,0,10">
                        <TextBlock Name="lblStatusLote" Text="Vídeo 1/1" FontSize="11" Margin="0,0,0,5"/>
                        <Grid>
                            <ProgressBar Name="pbProgresso" Style="{StaticResource ProgressLote}"/>
                            <TextBlock Name="lblPorcentagem" Text="0%" HorizontalAlignment="Right" Margin="0,-20,0,0" FontWeight="Bold" Foreground="#FF033150"/>
                        </Grid>
                    </StackPanel>
                    <Button Name="btnProcessar" Content="CONVERTER TUDO PARA MP4" Height="50" Style="{StaticResource BotaoArredondado}" Click="BtnProcessar_Click" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>  <!-- fecha painelConfigCompleto -->

            <!-- Painel de Cronoanálise (modo crono) -->
            <Border Name="pnlCrono" Visibility="Collapsed" Background="#FFF8FAFC" BorderBrush="#FFD7DEE8" BorderThickness="1" CornerRadius="10">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header arrastável -->
                    <Grid Grid.Row="0" Background="Transparent" Cursor="Hand" Margin="-10,-10,-10,0" MouseLeftButtonDown="CronoPanelHeader_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="☰" FontSize="12" Foreground="#999" Margin="10,8,8,6" ToolTip="Arraste para desacoplar"/>
                        <TextBlock Grid.Column="1" Text="⏱ CRONOANÁLISE" FontWeight="Bold" FontSize="11" Foreground="#FF033150" VerticalAlignment="Center" Margin="0,8,0,6"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <Button Name="btnNovaOperacao" Content="+ Nova Operação" Padding="10,4" FontSize="11"
                                Style="{StaticResource BotaoArredondado}" Background="#FF033150" Click="BtnNovaOperacao_Click"/>
                        <Button Name="btnExportarCrono" Content="Exportar CSV" Padding="8,4" FontSize="11" Margin="5,0,0,0"
                                Style="{StaticResource BotaoArredondado}" Background="#666" Click="BtnExportarCrono_Click"/>
                        <Button Name="btnLimparCrono" Content="Limpar" Padding="8,4" FontSize="11" Margin="5,0,0,0"
                                Style="{StaticResource BotaoArredondado}" Background="#FFA90C0C" Click="BtnLimparCrono_Click"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <DataGrid Name="gridCrono" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="True" IsReadOnly="False" HeadersVisibility="Column"
                                  BorderBrush="#FFD4DEE8" BorderThickness="1" Background="#FFFCFDFE" RowBackground="White"
                                  AlternatingRowBackground="#FFF6FAFD" SelectionMode="Single"
                                  SelectionUnit="CellOrRowHeader" FontSize="11" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#FFE6EDF5" VerticalGridLinesBrush="Transparent"
                                  RowHeaderWidth="0" SnapsToDevicePixels="True"
                                  CellEditEnding="GridCrono_CellEditEnding"
                                  BeginningEdit="GridCrono_BeginningEdit"
                                  PreviewKeyDown="GridCrono_PreviewKeyDown">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#FFF1F6FB"/>
                                    <Setter Property="Foreground" Value="#FF264A66"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="BorderBrush" Value="#FFDDE7F1"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="MinHeight" Value="26"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFF3F8FF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="BorderBrush" Value="#FFE6EDF5"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFF5F9FF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#FFDDEEFF"/>
                                            <Setter Property="BorderBrush" Value="#FF84B8F5"/>
                                            <Setter Property="Foreground" Value="#FF0F3156"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True"/>
                                                <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Background" Value="#FFE8EEF6"/>
                                            <Setter Property="BorderBrush" Value="#FFAAC1DC"/>
                                            <Setter Property="Foreground" Value="#FF2D445D"/>
                                        </MultiTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Operação" Binding="{Binding Operacao, UpdateSourceTrigger=PropertyChanged}" Width="220" MinWidth="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="4,2"/>
                                            <Setter Property="TextBlock.FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Par 1 -->
                                <DataGridTextColumn Header="Início 1" Binding="{Binding Inicio1Display, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=300}" Width="95" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.Foreground" Value="#0A0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Fim 1" Binding="{Binding Fim1Display, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=300}" Width="95" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.Foreground" Value="#C00"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- Par 2 -->
                                <DataGridTextColumn Header="Início 2" Binding="{Binding Inicio2Display, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=300}" Width="95" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.Foreground" Value="#0A0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Fim 2" Binding="{Binding Fim2Display, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=300}" Width="95" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.Foreground" Value="#C00"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- Par 3 -->
                                <DataGridTextColumn Header="Início 3" Binding="{Binding Inicio3Display, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=300}" Width="95" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.Foreground" Value="#0A0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Fim 3" Binding="{Binding Fim3Display, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=300}" Width="95" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.Foreground" Value="#C00"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- Par 4 -->
                                <DataGridTextColumn Header="Início 4" Binding="{Binding Inicio4Display, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=300}" Width="95" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.Foreground" Value="#0A0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Fim 4" Binding="{Binding Fim4Display, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=300}" Width="95" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.Foreground" Value="#C00"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- Duração total -->
                                <DataGridTextColumn Header="Duração" Binding="{Binding DuracaoDisplay}" Width="100" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.FontWeight" Value="Bold"/>
                                            <Setter Property="TextBlock.Foreground" Value="#033150"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Análise Estatística - Desvio Padrão -->
                                <DataGridTemplateColumn Header="Análise (Desvio)" Width="180" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Mini gráfico de barra -->
                                                <Grid Grid.Column="0" Height="18" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <!-- Fundo do gráfico -->
                                                    <Border Background="#F0F0F0" CornerRadius="2" BorderBrush="#DDD" BorderThickness="1"/>

                                                    <!-- Linha central (média) -->
                                                    <Line X1="0" X2="0" Y1="0" Y2="18" Stroke="#999" StrokeThickness="1" 
                                                          HorizontalAlignment="Center" StrokeDashArray="2,2"/>

                                                    <!-- Barra de desvio -->
                                                    <Border HorizontalAlignment="Center" 
                                                            Width="{Binding BarraLargura}" 
                                                            Height="14" 
                                                            Background="{Binding BarraCorBrush}" 
                                                            CornerRadius="2"
                                                            VerticalAlignment="Center"
                                                            Opacity="0.8"/>
                                                </Grid>

                                                <!-- Texto do desvio -->
                                                <TextBlock Grid.Column="1" 
                                                           Text="{Binding DesvioTexto}" 
                                                           FontFamily="Consolas" 
                                                           FontSize="10" 
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding BarraCorBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>

                </Grid>
            </Border>  <!-- fecha pnlCrono -->
        </Grid>  <!-- fecha gridInferior -->
    </Grid>  <!-- fecha gridConteudo -->
</Grid>  <!-- fecha grid coluna direita -->
</Window>