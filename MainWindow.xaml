<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor de Vídeo (Padronização)" 
        Height="750" Width="1050" MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F5F7" FontFamily="Segoe UI Variable Text, Segoe UI" TextElement.Foreground="#FF1D1D1F"
        KeyboardNavigation.DirectionalNavigation="None">

    <Window.Resources>
        <Style x:Key="SliderYoutube" TargetType="Slider">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Cursor="Hand">
                            <Border Height="4" Background="#FFD1D1D6" VerticalAlignment="Center" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#FF007AFF" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Cursor="Hand" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="bolinha" Width="16" Height="16" Fill="White" Stroke="#FFC7C7CC" StrokeThickness="1" Margin="-1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProgressLote" TargetType="ProgressBar">
            <Setter Property="Background" Value="#FFE5E5EA"/>
            <Setter Property="Foreground" Value="#FF007AFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid Height="6">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="3"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="2,0,0,10">
                <TextBlock Text="Galeria" FontSize="15" FontWeight="SemiBold" Foreground="#FF1D1D1F"/>
                <TextBlock Text="Arraste vídeos para cá" FontSize="11" Foreground="#FF86868B" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Row="1" Background="White" BorderBrush="#FFE5E5EA" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <ListBox Name="lstGaleria" SelectionChanged="LstGaleria_SelectionChanged" BorderThickness="0" Background="Transparent" Padding="4" AllowDrop="True" Drop="LstGaleria_Drop" MouseRightButtonUp="LstGaleria_MouseRightButtonUp"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Name="bdrCard" Grid.ColumnSpan="2" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="6" Padding="4,3" Margin="-2,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Name="icoCrono" Grid.Column="0" Style="{StaticResource Icone}" Text="&#xE916;" FontSize="12" Foreground="#FF007AFF" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
                                    <TextBlock Grid.Column="1" Text="{Binding NomeComFlag}" VerticalAlignment="Center" TextWrapping="WrapWithOverflow" Margin="0,1,4,1"/>
                                    <Button Grid.Column="2" Content="&#xE711;" FontFamily="{StaticResource FonteIcones}" Width="20" Height="20" FontSize="10"
                                            Foreground="#FFAEAEB2" Background="Transparent" BorderThickness="0"
                                            Cursor="Hand" ToolTip="Remover este vídeo"
                                            Click="BtnRemoverVideoGaleria_Click"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding TemCronoAnalise}" Value="True">
                                <Setter TargetName="bdrCard" Property="Background" Value="#FFE5F1FF"/>
                                <Setter TargetName="bdrCard" Property="BorderBrush" Value="#FF007AFF"/>
                                <Setter TargetName="bdrCard" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="icoCrono" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="item" Background="Transparent" CornerRadius="8" Padding="6,4" Margin="0,1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="item" Property="Background" Value="#FFF5F5F7"/></Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="item" Property="Background" Value="#FFE8E8ED"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="✓ Marcar/Desmarcar Cronoanálise" Click="ToggleCronoAnaliseFlag_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <Button Content="Vídeo" Tag="&#xE714;" Click="BtnAbrirArquivos_Click" Style="{StaticResource BotaoArredondado}" Height="35" Margin="0,0,0,5"/>
                <Button Content="Pasta" Tag="&#xE8B7;" Click="BtnAbrirPasta_Click" Style="{StaticResource BotaoArredondado}" Height="35" Margin="0,0,0,5"/>
                <Button Content="Limpar lista" Tag="&#xE74D;" Click="BtnLimpar_Click" Style="{StaticResource BotaoPerigo}" Height="35"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" x:Name="gridConteudo">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*" MinHeight="170"/>
            </Grid.RowDefinitions>

            <!-- ===== TOPO: Vídeo + Controlos ===== -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="Black" CornerRadius="10" MouseLeftButtonDown="BorderVideo_MouseLeftButtonDown">
                <Grid>
                    <MediaElement Name="VisualizadorVideo" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" MediaOpened="VisualizadorVideo_MediaOpened"/>
                    <Image Name="imgFrameBuffer" Stretch="Uniform" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Grid Name="gridControles" Grid.Row="1" Margin="0,15,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ===== LINHA 1: Linha do tempo em largura total ===== -->
                <TextBlock Name="lblTempoAtual" Text="00:00:00" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#FF86868B" FontFamily="Consolas"/>

                <Grid Grid.Row="0" Grid.Column="1" Name="gridSliderCorte" Height="35" SizeChanged="GridSliderCorte_SizeChanged">
                    <Slider Name="slLinhaTempo" Focusable="False" Style="{StaticResource SliderYoutube}"
                            Thumb.DragStarted="SlLinhaTempo_DragStarted"
                            Thumb.DragCompleted="SlLinhaTempo_DragCompleted"
                            ValueChanged="SlLinhaTempo_ValueChanged"
                            PreviewMouseLeftButtonDown="SlLinhaTempo_PreviewMouseLeftButtonDown"
                            Panel.ZIndex="1"/>

                    <Canvas Name="canvasCorte" IsHitTestVisible="False" VerticalAlignment="Center" Height="16" Margin="6,0,6,0" Panel.ZIndex="2">
                        <Border Name="bdrCorte" Height="16" BorderBrush="Black" BorderThickness="4,1,4,1" Background="Transparent" Visibility="Hidden" CornerRadius="2"/>
                    </Canvas>

                    <Popup Name="popupTempoDrag" Placement="Mouse" AllowsTransparency="True" IsOpen="False" Panel.ZIndex="3">
                        <Border Background="#CC000000" CornerRadius="5" Padding="8,4">
                            <TextBlock Name="lblTempoDrag" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        </Border>
                    </Popup>
                </Grid>

                <TextBlock Name="lblTempoTotal" Text="00:00:00" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#FF86868B" FontFamily="Consolas"/>

                <!-- ===== LINHA 2: Blocos dos segmentos, logo abaixo da linha do tempo ===== -->
                <Canvas Name="canvasSegmentos" Grid.Row="1" Grid.Column="1" Height="26" Margin="6,8,6,0"
                        ClipToBounds="False" Visibility="Collapsed"/>

                <!-- ===== LINHA 3: Barra de ferramentas (reprodução | cortar | ferramentas) ===== -->
                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Reprodução -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Name="btnFrameAnterior" Padding="0" Tag="&#xE76B;" Width="40" Height="35" Style="{StaticResource BotaoArredondado}" Click="BtnFrameAnterior_Click" ToolTip="Frame anterior"/>
                        <Button Name="btnPlayPause" Padding="0" Tag="&#xE768;" Width="40" Height="35" Style="{StaticResource BotaoArredondado}" Click="BtnPlayPause_Click" Margin="4,0,0,0" ToolTip="Reproduzir / Pausar"/>
                        <Button Name="btnFrameProximo" Padding="0" Tag="&#xE76C;" Width="40" Height="35" Style="{StaticResource BotaoArredondado}" Click="BtnFrameProximo_Click" Margin="4,0,0,0" ToolTip="Próximo frame"/>
                        <ToggleButton Name="btnMuteAudio" Padding="0" Tag="&#xE767;" Width="40" Height="35" Margin="4,0,0,0"
                                      Style="{StaticResource BotaoArredondadoToggle}"
                                      Checked="BtnMuteAudio_Checked" Unchecked="BtnMuteAudio_Unchecked"
                                      ToolTip="Ativar/Desativar áudio do vídeo"/>
                        <Button Name="btnVelocidadeMenos" Padding="0" Tag="&#xE738;" Width="36" Height="35" Margin="12,0,0,0"
                                Style="{StaticResource BotaoArredondado}"
                                Click="BtnVelocidadeMenos_Click" FontSize="18" FontWeight="Bold"
                                ToolTip="Diminuir velocidade"/>
                        <TextBlock Name="lblVelocidade" Text="1.0×" VerticalAlignment="Center" TextAlignment="Center" Width="40"
                                   Foreground="#FF86868B" FontWeight="Bold" FontSize="13"
                                   ToolTip="Velocidade atual de reprodução"/>
                        <Button Name="btnVelocidadeMais" Padding="0" Tag="&#xE710;" Width="36" Height="35"
                                Style="{StaticResource BotaoArredondado}"
                                Click="BtnVelocidadeMais_Click" FontSize="18" FontWeight="Bold"
                                ToolTip="Aumentar velocidade"/>
                    </StackPanel>

                    <!-- Corte: ação principal, destacada no centro -->
                    <Button Name="btnRegistrarTempo" Grid.Column="1" Content="Registrar tempo" Tag="&#xE8C6;" Click="BtnRegistrarTempo_Click"
                            HorizontalAlignment="Center" MinWidth="160" Height="35" Padding="14,0"
                            Style="{StaticResource BotaoPrimario}" FontSize="13" FontWeight="SemiBold"
                            ToolTip="Clique no início e depois no fim do trecho. O menor tempo vira o início e o maior o fim do segmento."/>

                    <!-- Ferramentas -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ToggleButton Name="btnModoCrono" Content="Crono" Tag="&#xE916;" Width="90" Height="35"
                                      Style="{StaticResource BotaoArredondadoToggle}"
                                      Checked="BtnModoCrono_Checked" Unchecked="BtnModoCrono_Unchecked"
                                      ToolTip="Ativar/Desativar modo cronoanálise"/>
                        <Button Name="btnPropriedades" Tag="&#xE946;" Padding="0" Width="40" Height="35" Margin="4,0,0,0"
                                Style="{StaticResource BotaoArredondado}"
                                Click="BtnPropriedades_Click"
                                ToolTip="Propriedades do arquivo de vídeo"/>
                        <Button Name="btnConfigAtalhos" Tag="&#xE713;" Padding="0" Width="40" Height="35" Margin="4,0,0,0"
                                Style="{StaticResource BotaoArredondado}"
                                Click="BtnConfigAtalhos_Click"
                                ToolTip="Configurar atalhos de teclado"/>
                    </StackPanel>
                </Grid>
            </Grid>  <!-- fecha barra de controlos -->
            </Grid>  <!-- fecha wrapper topo (video + controlos) -->

            <!-- ===== SEPARADOR ===== -->
            <GridSplitter Name="gridSplitterCrono" Focusable="False" IsTabStop="False" Grid.Row="1" Height="8" HorizontalAlignment="Stretch"
                          VerticalAlignment="Center" Background="Transparent" ShowsPreview="True"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          ToolTip="Arraste para ajustar a altura da área inferior"/>

            <!-- ===== INFERIOR: Config Video / Exportação OU Cronoanálise ===== -->
            <Grid Grid.Row="2" x:Name="gridInferior" Margin="0,0,0,10">

                <!-- Painel de Cortes + Orientação + Exportação (modo normal) -->
                <Grid Name="painelConfigCompleto">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Área rolável: passos de edição -->
                    <ScrollViewer Name="svConfigCompleto" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,0">
                            <GroupBox Name="grpConfigVideo" Header="1 · Cortes do vídeo" Padding="12,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Name="lblProximaParte" Grid.Column="0" FontWeight="SemiBold" Foreground="#FF007AFF" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   ToolTip="Cada segmento é exportado conforme a opção escolhida ao converter; sem segmentos, exporta o vídeo inteiro."/>
                                        <Button Name="btnLimparSegmentos" Grid.Column="1" Content="Remover todos" Tag="&#xE74D;" Height="24" Padding="8,0" Visibility="Collapsed"
                                                Style="{StaticResource BotaoPerigo}" FontSize="11"
                                                ToolTip="Remove todos os segmentos deste vídeo"
                                                Click="BtnLimparSegmentos_Click"/>
                                    </Grid>
                                    <TextBlock Name="txtDicaSegmentos" Foreground="#FF777777" FontSize="11" TextWrapping="Wrap"/>
                                    <ScrollViewer Name="svSegmentos" MaxHeight="70" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                        <WrapPanel Name="wrapSegmentos"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="2 · Orientação" Padding="12,8" Margin="0,0,0,8">
                                <WrapPanel>
                                    <RadioButton Name="rbNormal" Content="Normal" IsChecked="True" Margin="0,0,15,0"/>
                                    <RadioButton Name="rbRotDireita" Content="Girar 90° D" Margin="0,0,15,0"/>
                                    <RadioButton Name="rbRotEsquerda" Content="Girar 90° E" Margin="0,0,15,0"/>
                                    <RadioButton Name="rbRot180" Content="180°" Margin="0,0,15,0"/>
                                    <RadioButton Name="rbEspelharH" Content="Espelhar H" Margin="0,0,15,0"/>
                                    <RadioButton Name="rbEspelharV" Content="Espelhar V"/>
                                </WrapPanel>
                            </GroupBox>

                            <Expander Name="expExportacaoDesempenho" Header="3 · Opções de exportação e desempenho" Margin="0,0,0,8" IsExpanded="False" Padding="12,10">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="Local de Guardar:" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <RadioButton Name="rbSalvarPastaEscolhida" Content="Escolher uma pasta" IsChecked="True" Margin="0,0,15,0" Checked="RbSalvarPasta_Checked"/>
                                        <RadioButton Name="rbSalvarPastaOriginal" Content="Guardar na mesma pasta do original (adiciona '_editado')" Checked="RbSalvarPasta_Checked"/>
                                    </StackPanel>

                                    <CheckBox Name="chkDeletarOriginal" Content="Eliminar vídeo original após a conversão com sucesso" Margin="0,0,0,15" Checked="ChkDeletarOriginal_Checked" Unchecked="ChkDeletarOriginal_Checked"/>

                                    <TextBlock Text="Uso de Processador (CPU):" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Name="rbDesempenhoAlto" Content="Alto Desempenho (Sem limites)" IsChecked="True" Margin="0,0,15,0" Checked="RbDesempenho_Checked"/>
                                        <RadioButton Name="rbDesempenhoEco" Content="Modo Económico (Limitar a 50% para não bloquear o PC)" Checked="RbDesempenho_Checked"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Ação final sempre visível (fora da rolagem) -->
                    <StackPanel Name="painelExportacao" Grid.Row="1" Margin="0,4,0,0">
                        <StackPanel Name="painelProgresso" Visibility="Collapsed" Margin="0,0,0,8">
                            <TextBlock Name="lblStatusLote" Text="Vídeo 1/1" FontSize="11" Margin="0,0,0,5"/>
                            <Grid>
                                <ProgressBar Name="pbProgresso" Style="{StaticResource ProgressLote}"/>
                                <TextBlock Name="lblPorcentagem" Text="0%" HorizontalAlignment="Right" Margin="0,-20,0,0" FontWeight="Bold" Foreground="#FF033150"/>
                            </Grid>
                        </StackPanel>
                        <Button Name="btnProcessar" Content="CONVERTER TUDO PARA MP4" Height="46" Style="{StaticResource BotaoPrimario}" Click="BtnProcessar_Click" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>  <!-- fecha painelConfigCompleto -->

            <!-- Painel de Cronoanálise (modo crono) - estilo limpo, inspirado no padrão Apple -->
            <Border Name="pnlCrono" Visibility="Collapsed" Background="White" BorderBrush="#FFE5E5EA" BorderThickness="1" CornerRadius="12">
                <Grid Margin="14,12,14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho: título à esquerda, ações à direita (arrastar o título desacopla o painel) -->
                    <Grid Grid.Row="0" Background="Transparent" Cursor="Hand" Margin="0,0,0,10" MouseLeftButtonDown="CronoPanelHeader_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Cronoanálise" FontSize="15" FontWeight="SemiBold" Foreground="#FF1D1D1F" VerticalAlignment="Center"
                                   ToolTip="Arraste para desacoplar o painel"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Cursor="Arrow">
                            <Button Name="btnNovaOperacao" Content="Operação" Tag="&#xE710;" Style="{StaticResource BotaoArredondado}" Click="BtnNovaOperacao_Click"
                                    ToolTip="Adicionar uma nova linha de operação"/>
                            <Button Name="btnExportarCrono" Content="Exportar CSV" Tag="&#xE896;" Margin="6,0,0,0" Style="{StaticResource BotaoArredondado}" Click="BtnExportarCrono_Click"/>
                            <Button Name="btnLimparCrono" Content="Limpar" Tag="&#xE894;" Margin="6,0,0,0" Style="{StaticResource BotaoPerigo}" Click="BtnLimparCrono_Click"
                                    ToolTip="Remove todas as operações deste vídeo"/>
                            <Button Name="btnLimparCache" Tag="&#xE74D;" Margin="6,0,0,0" Padding="9,5" Style="{StaticResource BotaoPerigo}" Click="BtnLimparCache_Click"
                                    ToolTip="Limpar todos os dados de cache da cronoanálise"/>
                        </StackPanel>
                    </Grid>

                    <!-- Reprodução e registro de tempo -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <Button Name="btnCronoFrameAnt" Tag="&#xE76B;" Width="36" Height="28" Padding="0" Style="{StaticResource BotaoArredondado}"
                                Click="BtnCronoFrameAnt_Click" ToolTip="Frame anterior"/>
                        <Button Name="btnCronoPlayPause" Tag="&#xE768;" Width="36" Height="28" Padding="0" Margin="4,0,0,0" Style="{StaticResource BotaoArredondado}"
                                Click="BtnCronoPlayPause_Click" ToolTip="Reproduzir / Pausar"/>
                        <Button Name="btnCronoFrameProx" Tag="&#xE76C;" Width="36" Height="28" Padding="0" Margin="4,0,0,0" Style="{StaticResource BotaoArredondado}"
                                Click="BtnCronoFrameProx_Click" ToolTip="Próximo frame"/>
                        <Button Name="btnCronoRegistrar" Content="Registrar tempo" Tag="&#xE7C1;" Height="28" Margin="12,0,0,0" Padding="14,0" Style="{StaticResource BotaoPrimario}"
                                Click="BtnCronoRegistrar_Click" ToolTip="Registra o tempo atual na célula selecionada"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <DataGrid Name="gridCrono" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="True" IsReadOnly="False" HeadersVisibility="Column"
                                  BorderThickness="0" Background="White" RowBackground="White"
                                  AlternatingRowBackground="White" SelectionMode="Extended"
                                  SelectionUnit="Cell" FontSize="12" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#FFF2F2F7" VerticalGridLinesBrush="Transparent"
                                  Foreground="#FF1D1D1F" RowHeaderWidth="0" SnapsToDevicePixels="True"
                                  CellEditEnding="GridCrono_CellEditEnding"
                                  BeginningEdit="GridCrono_BeginningEdit"
                                  PreviewTextInput="GridCrono_PreviewTextInput"
                                  PreviewKeyDown="GridCrono_PreviewKeyDown"
                                  SelectedCellsChanged="GridCrono_SelectedCellsChanged">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#FF86868B"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,8"/>
                                    <Setter Property="BorderBrush" Value="#FFE5E5EA"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="MinHeight" Value="34"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFF9F9FB"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border x:Name="cell" Background="{TemplateBinding Background}" CornerRadius="6" Margin="1" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#FFE5F1FF"/>
                                            <Setter Property="Foreground" Value="#FF1D1D1F"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True"/>
                                                <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Background" Value="#FFF2F2F7"/>
                                        </MultiTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <!-- Botão Excluir -->
                                <DataGridTemplateColumn Header=" " Width="36" CanUserResize="False" CanUserReorder="False" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellStyle>
                                        <!-- Coluna de ação: não selecionável nem focável (o botão ✕ continua clicável) -->
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                            <Setter Property="Focusable" Value="False"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="&#xE74D;" FontFamily="{StaticResource FonteIcones}" Width="24" Height="24" FontSize="12"
                                                    Foreground="#FFAEAEB2" Background="Transparent"
                                                    BorderThickness="0" Cursor="Hand"
                                                    ToolTip="Excluir este registo"
                                                    Click="BtnExcluirLinhaCrono_Click">
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Operação" Binding="{Binding Operacao, UpdateSourceTrigger=PropertyChanged}" Width="220" MinWidth="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="4,2"/>
                                            <Setter Property="TextBlock.FontWeight" Value="SemiBold"/>
                                            <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="AcceptsReturn" Value="True"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                            <EventSetter Event="TextBoxBase.TextChanged" Handler="TxtOperacaoEdicao_TextChanged"/>
                                            <EventSetter Event="UIElement.PreviewKeyDown" Handler="TxtOperacaoEdicao_PreviewKeyDown"/>
                                            <EventSetter Event="Keyboard.LostKeyboardFocus" Handler="TxtOperacaoEdicao_LostKeyboardFocus"/>
                                            <EventSetter Event="FrameworkElement.Unloaded" Handler="TxtOperacaoEdicao_Unloaded"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- Cliente -->
                                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente, UpdateSourceTrigger=PropertyChanged}" Width="160" MinWidth="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="4,2"/>
                                            <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="AcceptsReturn" Value="True"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- Número de Amostras -->
                                <DataGridTextColumn Header="Nº Amostras" Binding="{Binding NumeroAmostras, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="90" MinWidth="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="4,2"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- Par 1 -->
                                <DataGridTextColumn Header="Início 1" Binding="{Binding Inicio1Display, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=300}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.Foreground" Value="#FF007AFF"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Fim 1" Binding="{Binding Fim1Display, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=300}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.Foreground" Value="#FFFF3B30"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- Par 2 -->
                                <DataGridTextColumn Header="Início 2" Binding="{Binding Inicio2Display, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=300}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.Foreground" Value="#FF007AFF"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Fim 2" Binding="{Binding Fim2Display, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=300}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.Foreground" Value="#FFFF3B30"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- Par 3 -->
                                <DataGridTextColumn Header="Início 3" Binding="{Binding Inicio3Display, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=300}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.Foreground" Value="#FF007AFF"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Fim 3" Binding="{Binding Fim3Display, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=300}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.Foreground" Value="#FFFF3B30"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- Par 4 -->
                                <DataGridTextColumn Header="Início 4" Binding="{Binding Inicio4Display, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=300}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.Foreground" Value="#FF007AFF"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Fim 4" Binding="{Binding Fim4Display, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=300}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.Foreground" Value="#FFFF3B30"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- Duração total -->
                                <DataGridTemplateColumn Header="Duração" Width="100" IsReadOnly="True" CanUserResize="False" CanUserReorder="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFE5F1FF" CornerRadius="6" Padding="8,2" Margin="4,3" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding DuracaoDisplay}" FontFamily="Consolas" FontWeight="SemiBold"
                                                           Foreground="#FF007AFF" TextAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Análise Estatística - Desvio Padrão -->
                                <DataGridTemplateColumn Header="Análise (Desvio)" Width="220" IsReadOnly="True" CanUserResize="False" CanUserReorder="False">
                                    <DataGridTemplateColumn.CellStyle>
                                        <!-- Análise é calculada: não selecionável, não focável e sem interação com o mouse -->
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="IsHitTestVisible" Value="False"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTemplateColumn.CellStyle>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Mini gráfico de barra -->
                                                <Grid Grid.Column="0" Height="18" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <!-- Fundo do gráfico -->
                                                    <Border Background="#F0F0F0" CornerRadius="2" BorderBrush="#DDD" BorderThickness="1"/>

                                                    <!-- Linha central (média) -->
                                                    <Line X1="0" X2="0" Y1="0" Y2="18" Stroke="#999" StrokeThickness="1" 
                                                          HorizontalAlignment="Center" StrokeDashArray="2,2"/>

                                                    <!-- Barra de desvio -->
                                                    <Border HorizontalAlignment="Center" 
                                                            Width="{Binding BarraLargura}" 
                                                            Height="14" 
                                                            Background="{Binding BarraCorBrush}" 
                                                            CornerRadius="2"
                                                            VerticalAlignment="Center"
                                                            Opacity="0.8"/>
                                                </Grid>

                                                <!-- Texto do desvio -->
                                                <TextBlock Grid.Column="1" 
                                                           Text="{Binding DesvioTexto}" 
                                                           FontFamily="Consolas" 
                                                           FontSize="10" 
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding BarraCorBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>

                    <!-- Barra de status de seleção (Row 4) -->
                    <Border x:Name="pnlCronoSelecao" Grid.Row="4" Visibility="Collapsed"
                            Background="#FFF5F5F7" CornerRadius="8"
                            Margin="0,8,0,0" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Seleção" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#FF1D1D1F" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Soma" FontSize="11" Foreground="#FF86868B"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="lblCronoSoma" FontSize="11" FontWeight="SemiBold"
                                       FontFamily="Consolas" Foreground="#FF1D1D1F"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock Text="Média" FontSize="11" Foreground="#FF86868B"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="lblCronoMedia" FontSize="11" FontWeight="SemiBold"
                                       FontFamily="Consolas" Foreground="#FF007AFF"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock x:Name="lblCronoQtd" FontSize="10" Foreground="#FF86868B"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Lista suspensa de sugestões de operação (opções já usadas neste vídeo) -->
                    <Popup Name="popupOperacoes" Placement="Bottom" StaysOpen="True" AllowsTransparency="True" IsOpen="False">
                        <Border Background="White" BorderBrush="#FF3399FF" BorderThickness="1" CornerRadius="4" Padding="2">
                            <ListBox Name="lstOperacoes" Focusable="False" MaxHeight="160" BorderThickness="0" FontSize="11"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewMouseLeftButtonDown="LstOperacoes_PreviewMouseLeftButtonDown">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Padding" Value="6,3"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </Popup>

                </Grid>
            </Border>  <!-- fecha pnlCrono -->
        </Grid>  <!-- fecha gridInferior -->
    </Grid>  <!-- fecha gridConteudo -->
</Grid>  <!-- fecha grid coluna direita -->
</Window>