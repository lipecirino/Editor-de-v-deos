<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor de Vídeo (Padronização)" 
        Height="750" Width="1050" MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="BotaoArredondado" TargetType="Button">
            <Setter Property="Background" Value="#FF033150"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderYoutube" TargetType="Slider">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Cursor="Hand">
                            <Border Height="4" Background="#FF5A5A5A" VerticalAlignment="Center" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton>
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#FFFF0000" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="bolinha" Width="16" Height="16" Fill="#FFAAAAAA" Margin="-1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoArredondadoToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#FF033150"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProgressLote" TargetType="ProgressBar">
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="Foreground" Value="#FFFF0000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid Height="6">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="3"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="GALERIA (Arraste seu Vídeo aqui)" FontWeight="Bold" Foreground="#888" Margin="0,0,0,10"/>
            <ListBox Name="lstGaleria" Grid.Row="1" SelectionChanged="LstGaleria_SelectionChanged" BorderThickness="0" Background="#F9F9F9" AllowDrop="True" Drop="LstGaleria_Drop" MouseRightButtonUp="LstGaleria_MouseRightButtonUp"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Name="bdrCard" Grid.ColumnSpan="2" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="6" Padding="4,3" Margin="-2,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Name="icoCrono" Grid.Column="0" Text="⏱" FontSize="12" Foreground="#FF6A4C93" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
                                    <TextBlock Grid.Column="1" Text="{Binding NomeComFlag}" VerticalAlignment="Center" TextWrapping="WrapWithOverflow" Margin="0,1,4,1"/>
                                    <Button Grid.Column="2" Content="✕" Width="20" Height="20" FontSize="10"
                                            Foreground="#FFE81123" Background="Transparent" BorderThickness="0"
                                            Cursor="Hand" ToolTip="Remover este vídeo"
                                            Click="BtnRemoverVideoGaleria_Click"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding TemCronoAnalise}" Value="True">
                                <Setter TargetName="bdrCard" Property="Background" Value="#FFE8F0FE"/>
                                <Setter TargetName="bdrCard" Property="BorderBrush" Value="#FF6A4C93"/>
                                <Setter TargetName="bdrCard" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="icoCrono" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="✓ Marcar/Desmarcar Cronoanálise" Click="ToggleCronoAnaliseFlag_Click"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <Button Content="+ Video" Click="BtnAbrirArquivos_Click" Style="{StaticResource BotaoArredondado}" Height="35" Margin="0,0,0,5" Background="#FF033150"/>
                <Button Content="+ Pasta" Click="BtnAbrirPasta_Click" Style="{StaticResource BotaoArredondado}" Height="35" Margin="0,0,0,5" Background="#FF033150"/>
                <Button Content="Limpar lista" Click="BtnLimpar_Click" Style="{StaticResource BotaoArredondado}" Height="35" Background="#FFA90C0C"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" x:Name="gridConteudo">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*" MinHeight="170"/>
            </Grid.RowDefinitions>

            <!-- ===== TOPO: Vídeo + Controlos ===== -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="Black" CornerRadius="10" MouseLeftButtonDown="BorderVideo_MouseLeftButtonDown">
                <Grid>
                    <MediaElement Name="VisualizadorVideo" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" MediaOpened="VisualizadorVideo_MediaOpened"/>
                    <Image Name="imgFrameBuffer" Stretch="Uniform" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <Grid Name="gridControles" Grid.Row="1" Margin="0,15,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ===== LINHA 1: Linha do tempo em largura total ===== -->
                <TextBlock Name="lblTempoAtual" Text="00:00:00" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#666" FontFamily="Consolas"/>

                <Grid Grid.Row="0" Grid.Column="1" Name="gridSliderCorte" Height="35" SizeChanged="GridSliderCorte_SizeChanged">
                    <Slider Name="slLinhaTempo" Style="{StaticResource SliderYoutube}"
                            Thumb.DragStarted="SlLinhaTempo_DragStarted"
                            Thumb.DragCompleted="SlLinhaTempo_DragCompleted"
                            ValueChanged="SlLinhaTempo_ValueChanged"
                            PreviewMouseLeftButtonDown="SlLinhaTempo_PreviewMouseLeftButtonDown"
                            Panel.ZIndex="1"/>

                    <Canvas Name="canvasCorte" IsHitTestVisible="False" VerticalAlignment="Center" Height="16" Margin="6,0,6,0" Panel.ZIndex="2">
                        <Border Name="bdrCorte" Height="16" BorderBrush="Black" BorderThickness="4,1,4,1" Background="Transparent" Visibility="Hidden" CornerRadius="2"/>
                    </Canvas>

                    <Popup Name="popupTempoDrag" Placement="Mouse" AllowsTransparency="True" IsOpen="False" Panel.ZIndex="3">
                        <Border Background="#CC000000" CornerRadius="5" Padding="8,4">
                            <TextBlock Name="lblTempoDrag" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        </Border>
                    </Popup>
                </Grid>

                <TextBlock Name="lblTempoTotal" Text="00:00:00" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#666" FontFamily="Consolas"/>

                <!-- ===== LINHA 2: Blocos dos segmentos, logo abaixo da linha do tempo ===== -->
                <Canvas Name="canvasSegmentos" Grid.Row="1" Grid.Column="1" Height="26" Margin="6,8,6,0"
                        ClipToBounds="False" Visibility="Collapsed"/>

                <!-- ===== LINHA 3: Barra de ferramentas (reprodução | cortar | ferramentas) ===== -->
                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Reprodução -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Name="btnFrameAnterior" Content="⏮" Width="40" Height="35" Style="{StaticResource BotaoArredondado}" Click="BtnFrameAnterior_Click" ToolTip="Frame anterior"/>
                        <Button Name="btnPlayPause" Content="▶" Width="40" Height="35" Style="{StaticResource BotaoArredondado}" Click="BtnPlayPause_Click" Margin="4,0,0,0" ToolTip="Reproduzir / Pausar"/>
                        <Button Name="btnFrameProximo" Content="⏭" Width="40" Height="35" Style="{StaticResource BotaoArredondado}" Click="BtnFrameProximo_Click" Margin="4,0,0,0" ToolTip="Próximo frame"/>
                        <ToggleButton Name="btnMuteAudio" Content="🔊" Width="40" Height="35" Margin="4,0,0,0"
                                      Style="{StaticResource BotaoArredondadoToggle}" Background="#FF033150"
                                      Checked="BtnMuteAudio_Checked" Unchecked="BtnMuteAudio_Unchecked"
                                      ToolTip="Ativar/Desativar áudio do vídeo"/>
                        <Button Name="btnVelocidadeMenos" Content="−" Width="36" Height="35" Margin="12,0,0,0"
                                Style="{StaticResource BotaoArredondado}" Background="#FF555555"
                                Click="BtnVelocidadeMenos_Click" FontSize="18" FontWeight="Bold"
                                ToolTip="Diminuir velocidade"/>
                        <TextBlock Name="lblVelocidade" Text="1.0×" VerticalAlignment="Center" TextAlignment="Center" Width="40"
                                   Foreground="#FFCC6600" FontWeight="Bold" FontSize="13"
                                   ToolTip="Velocidade atual de reprodução"/>
                        <Button Name="btnVelocidadeMais" Content="+" Width="36" Height="35"
                                Style="{StaticResource BotaoArredondado}" Background="#FF555555"
                                Click="BtnVelocidadeMais_Click" FontSize="18" FontWeight="Bold"
                                ToolTip="Aumentar velocidade"/>
                    </StackPanel>

                    <!-- Corte: ação principal, destacada no centro -->
                    <Button Name="btnRegistrarTempo" Grid.Column="1" Content="✂  Registrar tempo" Click="BtnRegistrarTempo_Click"
                            HorizontalAlignment="Center" MinWidth="160" Height="35" Padding="14,0"
                            Style="{StaticResource BotaoArredondado}" Background="#FF0F766E" FontSize="13" FontWeight="SemiBold"
                            ToolTip="Clique no início e depois no fim do trecho. O menor tempo vira o início e o maior o fim do segmento."/>

                    <!-- Ferramentas -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ToggleButton Name="btnModoCrono" Content="⏱ Crono" Width="75" Height="35"
                                      Style="{StaticResource BotaoArredondadoToggle}" Background="#FF6A4C93"
                                      Checked="BtnModoCrono_Checked" Unchecked="BtnModoCrono_Unchecked"
                                      ToolTip="Ativar/Desativar modo cronoanálise"/>
                        <Button Name="btnPropriedades" Width="40" Height="35" Margin="4,0,0,0"
                                Style="{StaticResource BotaoArredondado}" Background="#FF555555"
                                Click="BtnPropriedades_Click"
                                ToolTip="Propriedades do arquivo de vídeo">
                            <TextBlock Text="ℹ" FontSize="16" FontWeight="Bold"/>
                        </Button>
                        <Button Name="btnConfigAtalhos" Width="40" Height="35" Margin="4,0,0,0"
                                Style="{StaticResource BotaoArredondado}" Background="#FF555555"
                                Click="BtnConfigAtalhos_Click"
                                ToolTip="Configurar atalhos de teclado">
                    <Viewbox Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" RenderTransformOrigin="0.62,0.529">
                        <Path Data="M9.5,1 L9.5,3.5 C9.1,3.6 8.7,3.7 8.3,3.9 L6.3,2.5 L5.5,3.9 L7.3,5.6 C7.1,5.9 6.9,6.3 6.8,6.7 L4.5,7.2 L4.5,8.8 L6.8,9.3 C6.9,9.7 7.1,10.1 7.3,10.4 L5.5,12.1 L6.3,13.5 L8.3,12.1 C8.7,12.3 9.1,12.4 9.5,12.5 L9.5,15 L10.5,15 L10.5,12.5 C10.9,12.4 11.3,12.3 11.7,12.1 L13.7,13.5 L14.5,12.1 L12.7,10.4 C12.9,10.1 13.1,9.7 13.2,9.3 L15.5,8.8 L15.5,7.2 L13.2,6.7 C13.1,6.3 12.9,5.9 12.7,5.6 L14.5,3.9 L13.7,2.5 L11.7,3.9 C11.3,3.7 10.9,3.6 10.5,3.5 L10.5,1 L9.5,1 Z M10,5 C11.7,5 13,6.3 13,8 C13,9.7 11.7,11 10,11 C8.3,11 7,9.7 7,8 C7,6.3 8.3,5 10,5 Z" Fill="White" HorizontalAlignment="Left"/>
                    </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>  <!-- fecha barra de controlos -->
            </Grid>  <!-- fecha wrapper topo (video + controlos) -->

            <!-- ===== SEPARADOR ===== -->
            <GridSplitter Name="gridSplitterCrono" Grid.Row="1" Height="8" HorizontalAlignment="Stretch"
                          VerticalAlignment="Center" Background="#FFE2E8F0" ShowsPreview="True"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          ToolTip="Arraste para ajustar a altura da área inferior"/>

            <!-- ===== INFERIOR: Config Video / Exportação OU Cronoanálise ===== -->
            <Grid Grid.Row="2" x:Name="gridInferior" Margin="0,0,0,10">

                <!-- Painel de Cortes + Orientação + Exportação (modo normal) -->
                <Grid Name="painelConfigCompleto">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Área rolável: passos de edição -->
                    <ScrollViewer Name="svConfigCompleto" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,0">
                            <GroupBox Name="grpConfigVideo" Header="1 · Cortes do vídeo" Padding="12,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Name="lblProximaParte" Grid.Column="0" FontWeight="SemiBold" Foreground="#FF0F766E" VerticalAlignment="Center" TextWrapping="Wrap"
                                                   ToolTip="Cada segmento é exportado conforme a opção escolhida ao converter; sem segmentos, exporta o vídeo inteiro."/>
                                        <Button Name="btnLimparSegmentos" Grid.Column="1" Content="Remover todos" Height="24" Padding="8,0" Visibility="Collapsed"
                                                Style="{StaticResource BotaoArredondado}" Background="#FFA90C0C" FontSize="11"
                                                ToolTip="Remove todos os segmentos deste vídeo"
                                                Click="BtnLimparSegmentos_Click"/>
                                    </Grid>
                                    <TextBlock Name="txtDicaSegmentos" Foreground="#FF777777" FontSize="11" TextWrapping="Wrap"/>
                                    <ScrollViewer Name="svSegmentos" MaxHeight="70" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                        <WrapPanel Name="wrapSegmentos"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="2 · Orientação" Padding="12,8" Margin="0,0,0,8">
                                <WrapPanel>
                                    <RadioButton Name="rbNormal" Content="Normal" IsChecked="True" Margin="0,0,15,0"/>
                                    <RadioButton Name="rbRotDireita" Content="Girar 90° D" Margin="0,0,15,0"/>
                                    <RadioButton Name="rbRotEsquerda" Content="Girar 90° E" Margin="0,0,15,0"/>
                                    <RadioButton Name="rbRot180" Content="180°" Margin="0,0,15,0"/>
                                    <RadioButton Name="rbEspelharH" Content="Espelhar H" Margin="0,0,15,0"/>
                                    <RadioButton Name="rbEspelharV" Content="Espelhar V"/>
                                </WrapPanel>
                            </GroupBox>

                            <Expander Name="expExportacaoDesempenho" Header="3 · Opções de exportação e desempenho" Margin="0,0,0,8" IsExpanded="False" Background="#F0F0F0" Padding="10" BorderBrush="#DDD" BorderThickness="1">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="Local de Guardar:" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <RadioButton Name="rbSalvarPastaEscolhida" Content="Escolher uma pasta" IsChecked="True" Margin="0,0,15,0" Checked="RbSalvarPasta_Checked"/>
                                        <RadioButton Name="rbSalvarPastaOriginal" Content="Guardar na mesma pasta do original (adiciona '_editado')" Checked="RbSalvarPasta_Checked"/>
                                    </StackPanel>

                                    <CheckBox Name="chkDeletarOriginal" Content="Eliminar vídeo original após a conversão com sucesso" Margin="0,0,0,15" Checked="ChkDeletarOriginal_Checked" Unchecked="ChkDeletarOriginal_Checked"/>

                                    <TextBlock Text="Uso de Processador (CPU):" FontWeight="Bold" Margin="0,0,0,5" Foreground="#333"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Name="rbDesempenhoAlto" Content="Alto Desempenho (Sem limites)" IsChecked="True" Margin="0,0,15,0" Checked="RbDesempenho_Checked"/>
                                        <RadioButton Name="rbDesempenhoEco" Content="Modo Económico (Limitar a 50% para não bloquear o PC)" Checked="RbDesempenho_Checked"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Ação final sempre visível (fora da rolagem) -->
                    <StackPanel Name="painelExportacao" Grid.Row="1" Margin="0,4,0,0">
                        <StackPanel Name="painelProgresso" Visibility="Collapsed" Margin="0,0,0,8">
                            <TextBlock Name="lblStatusLote" Text="Vídeo 1/1" FontSize="11" Margin="0,0,0,5"/>
                            <Grid>
                                <ProgressBar Name="pbProgresso" Style="{StaticResource ProgressLote}"/>
                                <TextBlock Name="lblPorcentagem" Text="0%" HorizontalAlignment="Right" Margin="0,-20,0,0" FontWeight="Bold" Foreground="#FF033150"/>
                            </Grid>
                        </StackPanel>
                        <Button Name="btnProcessar" Content="CONVERTER TUDO PARA MP4" Height="46" Style="{StaticResource BotaoArredondado}" Click="BtnProcessar_Click" FontSize="14" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>  <!-- fecha painelConfigCompleto -->

            <!-- Painel de Cronoanálise (modo crono) -->
            <Border Name="pnlCrono" Visibility="Collapsed" Background="#FFF8FAFC" BorderBrush="#FFD7DEE8" BorderThickness="1" CornerRadius="10">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header arrastável -->
                    <Grid Grid.Row="0" Background="Transparent" Cursor="Hand" Margin="-10,-10,-10,0" MouseLeftButtonDown="CronoPanelHeader_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="☰" FontSize="12" Foreground="#999" Margin="10,8,8,6" ToolTip="Arraste para desacoplar"/>
                        <TextBlock Grid.Column="1" Text="⏱ CRONOANÁLISE" FontWeight="Bold" FontSize="11" Foreground="#FF033150" VerticalAlignment="Center" Margin="0,8,0,6"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                        <Button Name="btnNovaOperacao" Content="+ Nova Operação" Padding="10,4" FontSize="11"
                                Style="{StaticResource BotaoArredondado}" Background="#FF033150" Click="BtnNovaOperacao_Click"/>
                        <Button Name="btnExportarCrono" Content="Exportar CSV" Padding="8,4" FontSize="11" Margin="5,0,0,0"
                                Style="{StaticResource BotaoArredondado}" Background="#FF555555" Click="BtnExportarCrono_Click"/>
                        <Button Name="btnLimparCrono" Content="Limpar" Padding="8,4" FontSize="11" Margin="5,0,0,0"
                                Style="{StaticResource BotaoArredondado}" Background="#FFA90C0C" Click="BtnLimparCrono_Click"/>
                        <Button Name="btnLimparCache" Content="🗑 Cache" Padding="8,4" FontSize="11" Margin="5,0,0,0"
                                Style="{StaticResource BotaoArredondado}" Background="#FF8B4513" Click="BtnLimparCache_Click"
                                ToolTip="Limpar todos os dados de cache da cronoanálise"/>
                    </StackPanel>

                    <!-- Controlos de reprodução -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,6">
                        <Button Name="btnCronoFrameAnt" Content="⏮" Width="40" Height="26" FontSize="12"
                                Style="{StaticResource BotaoArredondado}" Background="#FF033150"
                                Click="BtnCronoFrameAnt_Click"/>
                        <Button Name="btnCronoPlayPause" Content="▶" Width="32" Height="26" FontSize="12" Margin="4,0,0,0"
                                Style="{StaticResource BotaoArredondado}" Background="#FF6A4C93"
                                Click="BtnCronoPlayPause_Click"/>
                        <Button Name="btnCronoFrameProx" Content="⏭" Width="40" Height="26" FontSize="12" Margin="4,0,0,0"
                                Style="{StaticResource BotaoArredondado}" Background="#FF033150"
                                Click="BtnCronoFrameProx_Click"/>
                        <Button Name="btnCronoRegistrar" Content="⏱ Registrar" Padding="8,3" FontSize="11" Margin="8,0,0,0"
                                Style="{StaticResource BotaoArredondado}" Background="#FF033150"
                                Click="BtnCronoRegistrar_Click"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <DataGrid Name="gridCrono" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="True" IsReadOnly="False" HeadersVisibility="Column"
                                  BorderBrush="#FFD4DEE8" BorderThickness="1" Background="#FFFCFDFE" RowBackground="White"
                                  AlternatingRowBackground="#FFF6FAFD" SelectionMode="Extended"
                                  SelectionUnit="Cell" FontSize="11" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#FFE6EDF5" VerticalGridLinesBrush="Transparent"
                                  RowHeaderWidth="0" SnapsToDevicePixels="True"
                                  CellEditEnding="GridCrono_CellEditEnding"
                                  BeginningEdit="GridCrono_BeginningEdit"
                                  PreviewTextInput="GridCrono_PreviewTextInput"
                                  PreviewKeyDown="GridCrono_PreviewKeyDown"
                                  SelectedCellsChanged="GridCrono_SelectedCellsChanged">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#FFF1F6FB"/>
                                    <Setter Property="Foreground" Value="#FF264A66"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="BorderBrush" Value="#FFDDE7F1"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="MinHeight" Value="26"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFF3F8FF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="BorderBrush" Value="#FFE6EDF5"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFF5F9FF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#FFC5E0FF"/>
                                            <Setter Property="BorderBrush" Value="#FF3399FF"/>
                                            <Setter Property="Foreground" Value="#FF0F3156"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True"/>
                                                <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Background" Value="#FFE8EEF6"/>
                                            <Setter Property="BorderBrush" Value="#FFAAC1DC"/>
                                            <Setter Property="Foreground" Value="#FF2D445D"/>
                                        </MultiTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <!-- Botão Excluir -->
                                <DataGridTemplateColumn Header=" " Width="36" CanUserResize="False" CanUserReorder="False" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Width="24" Height="24" FontSize="12"
                                                    Foreground="#FFE81123" Background="Transparent"
                                                    BorderThickness="0" Cursor="Hand"
                                                    ToolTip="Excluir este registo"
                                                    Click="BtnExcluirLinhaCrono_Click">
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Operação" Binding="{Binding Operacao, UpdateSourceTrigger=PropertyChanged}" Width="220" MinWidth="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="4,2"/>
                                            <Setter Property="TextBlock.FontWeight" Value="SemiBold"/>
                                            <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="AcceptsReturn" Value="True"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- Cliente -->
                                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente, UpdateSourceTrigger=PropertyChanged}" Width="160" MinWidth="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="4,2"/>
                                            <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="AcceptsReturn" Value="True"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- Número de Amostras -->
                                <DataGridTextColumn Header="Nº Amostras" Binding="{Binding NumeroAmostras, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="90" MinWidth="70">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="4,2"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- Par 1 -->
                                <DataGridTextColumn Header="Início 1" Binding="{Binding Inicio1Display, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=300}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.Foreground" Value="#FF0077B6"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Fim 1" Binding="{Binding Fim1Display, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=300}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.Foreground" Value="#FFD00000"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- Par 2 -->
                                <DataGridTextColumn Header="Início 2" Binding="{Binding Inicio2Display, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=300}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.Foreground" Value="#FF0077B6"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Fim 2" Binding="{Binding Fim2Display, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=300}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.Foreground" Value="#FFD00000"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- Par 3 -->
                                <DataGridTextColumn Header="Início 3" Binding="{Binding Inicio3Display, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=300}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.Foreground" Value="#FF0077B6"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Fim 3" Binding="{Binding Fim3Display, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=300}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.Foreground" Value="#FFD00000"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- Par 4 -->
                                <DataGridTextColumn Header="Início 4" Binding="{Binding Inicio4Display, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=300}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.Foreground" Value="#FF0077B6"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Fim 4" Binding="{Binding Fim4Display, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay, Delay=300}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.Foreground" Value="#FFD00000"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style TargetType="TextBox">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="3,2"/>
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                </DataGridTextColumn>

                                <!-- Duração total -->
                                <DataGridTextColumn Header="Duração" Binding="{Binding DuracaoDisplay}" Width="100" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style>
                                            <Setter Property="TextBlock.Margin" Value="3,2"/>
                                            <Setter Property="TextBlock.FontFamily" Value="Consolas"/>
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="TextBlock.FontWeight" Value="Bold"/>
                                            <Setter Property="TextBlock.Foreground" Value="#FFFFFF"/>
                                            <Setter Property="TextBlock.Background" Value="#FF033150"/>
                                            <Setter Property="TextBlock.Padding" Value="4,2"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Análise Estatística - Desvio Padrão -->
                                <DataGridTemplateColumn Header="Análise (Desvio)" Width="220" IsReadOnly="True" CanUserResize="False" CanUserReorder="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Mini gráfico de barra -->
                                                <Grid Grid.Column="0" Height="18" VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <!-- Fundo do gráfico -->
                                                    <Border Background="#F0F0F0" CornerRadius="2" BorderBrush="#DDD" BorderThickness="1"/>

                                                    <!-- Linha central (média) -->
                                                    <Line X1="0" X2="0" Y1="0" Y2="18" Stroke="#999" StrokeThickness="1" 
                                                          HorizontalAlignment="Center" StrokeDashArray="2,2"/>

                                                    <!-- Barra de desvio -->
                                                    <Border HorizontalAlignment="Center" 
                                                            Width="{Binding BarraLargura}" 
                                                            Height="14" 
                                                            Background="{Binding BarraCorBrush}" 
                                                            CornerRadius="2"
                                                            VerticalAlignment="Center"
                                                            Opacity="0.8"/>
                                                </Grid>

                                                <!-- Texto do desvio -->
                                                <TextBlock Grid.Column="1" 
                                                           Text="{Binding DesvioTexto}" 
                                                           FontFamily="Consolas" 
                                                           FontSize="10" 
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding BarraCorBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>

                    <!-- Barra de status de seleção (Row 4) -->
                    <Border x:Name="pnlCronoSelecao" Grid.Row="4" Visibility="Collapsed"
                            Background="#FFE8F0F8" BorderBrush="#FFB0C8E0" BorderThickness="0,1,0,0"
                            Margin="0,4,0,0" Padding="8,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Seleção:" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#FF033150" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Soma:" FontSize="11" Foreground="#FF555555"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="lblCronoSoma" FontSize="11" FontWeight="SemiBold"
                                       FontFamily="Consolas" Foreground="#FF033150"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock Text="Média:" FontSize="11" Foreground="#FF555555"
                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock x:Name="lblCronoMedia" FontSize="11" FontWeight="SemiBold"
                                       FontFamily="Consolas" Foreground="#FF6A4C93"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock x:Name="lblCronoQtd" FontSize="10" Foreground="#FF888888"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>  <!-- fecha pnlCrono -->
        </Grid>  <!-- fecha gridInferior -->
    </Grid>  <!-- fecha gridConteudo -->
</Grid>  <!-- fecha grid coluna direita -->
</Window>