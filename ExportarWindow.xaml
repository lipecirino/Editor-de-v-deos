<Window x:Class="ExportarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportar"
        Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CorFundoJanela}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextElement.Foreground="{StaticResource CorTexto}">

    <Window.Resources>
        <!-- Cor de destaque da tela: muda com o desempenho (verde = econômico, vermelho = alto) -->
        <SolidColorBrush x:Key="CorDestaque" Color="#FF34C759"/>
        <SolidColorBrush x:Key="CorDestaqueTexto" Color="#FF248A3D"/>
        <SolidColorBrush x:Key="CorDestaqueFundo" Color="#FFF2FBF4"/>
        <SolidColorBrush x:Key="CorDestaqueChip" Color="#FFE3F6E8"/>

        <!-- NÍVEL 1 – decisão principal: cartão grande com ícone, título e descrição -->
        <Style x:Key="OpcaoCartao" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="White" BorderBrush="{StaticResource CorBorda}" BorderThickness="1.5" CornerRadius="10" Padding="12,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="icoFundo" Width="34" Height="34" CornerRadius="8" Background="{StaticResource CorFundoCinza}" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ico" Style="{StaticResource Icone}" Text="{TemplateBinding Tag}" FontSize="16"
                                               Foreground="{StaticResource CorTextoSecundario}" HorizontalAlignment="Center"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                <Grid Grid.Column="2" Width="18" Height="18" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="anel" Stroke="{StaticResource CorCinzaDesativado}" StrokeThickness="1.5"/>
                                    <Ellipse x:Name="ponto" Fill="{DynamicResource CorDestaque}" Visibility="Collapsed"/>
                                    <TextBlock x:Name="check" Style="{StaticResource Icone}" Text="&#xE73E;" FontSize="10" Foreground="White"
                                               HorizontalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource CorCinzaDesativado}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource CorDestaque}"/>
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource CorDestaqueFundo}"/>
                                <Setter TargetName="icoFundo" Property="Background" Value="{DynamicResource CorDestaque}"/>
                                <Setter TargetName="ico" Property="Foreground" Value="White"/>
                                <Setter TargetName="anel" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ponto" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NÍVEL 2 – ajuste secundário: controle segmentado compacto -->
        <Style x:Key="Segmento" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="12,4">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="ico" Style="{StaticResource Icone}" Text="{TemplateBinding Tag}" FontSize="12" Foreground="{StaticResource CorTextoSecundario}" Margin="0,0,6,0"/>
                                <ContentPresenter x:Name="txt" VerticalAlignment="Center" TextElement.Foreground="{StaticResource CorTextoSecundario}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="White"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource CorDestaque}"/>
                                <Setter TargetName="b" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.12" Direction="270"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="ico" Property="Foreground" Value="{DynamicResource CorDestaque}"/>
                                <Setter TargetName="txt" Property="TextElement.Foreground" Value="{StaticResource CorTexto}"/>
                                <Setter TargetName="txt" Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Títulos: seção (nível 1) e texto de apoio -->
        <Style x:Key="TituloSecao" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource CorTexto}"/>
        </Style>
        <Style x:Key="DescSecao" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource CorTextoSecundario}"/>
            <Setter Property="Margin" Value="0,1,0,8"/>
        </Style>
        <Style x:Key="TituloOpcao" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource CorTexto}"/>
        </Style>
        <Style x:Key="DescOpcao" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource CorTextoSecundario}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <!-- Interruptor liga/desliga (CheckBox) com título e descrição no conteúdo -->
        <Style x:Key="Interruptor" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center"/>
                            <Border x:Name="trilho" Grid.Column="1" Width="38" Height="22" CornerRadius="11" Margin="12,0,0,0"
                                    Background="{StaticResource CorBordaForte}" VerticalAlignment="Center">
                                <Ellipse x:Name="botao" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="2,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.2" Direction="270"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="trilho" Property="Background" Value="{DynamicResource CorDestaque}"/>
                                <Setter TargetName="botao" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Campo de texto arredondado; Tag = texto de exemplo exibido enquanto vazio -->
        <Style x:Key="Campo" TargetType="TextBox">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource CorTexto}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CorBordaForte}"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
                            <Grid Margin="8,0">
                                <TextBlock x:Name="exemplo" Text="{TemplateBinding Tag}" Foreground="{StaticResource CorCinzaClaro}" FontSize="{TemplateBinding FontSize}"
                                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="exemplo" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource CorDestaque}"/>
                                <Setter TargetName="b" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RotuloCampo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource CorTextoMedio}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== CABEÇALHO: o que vai acontecer ===== -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,0,0,1" Padding="22,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="11" Background="{DynamicResource CorDestaque}" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icone}" Text="&#xE8AB;" FontSize="20" Foreground="White" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Exportar vídeos" FontSize="20" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Border Style="{StaticResource Chip}" Background="{DynamicResource CorDestaqueChip}">
                            <TextBlock Name="lblQtdVideos" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CorDestaqueTexto}"/>
                        </Border>
                        <Border Style="{StaticResource Chip}" Background="{StaticResource CorFundoCinza}">
                            <TextBlock Text="MP4 · H.264" FontSize="11" Foreground="{StaticResource CorTextoSecundario}"/>
                        </Border>
                        <Border Name="chipIgnorados" Style="{StaticResource Chip}" Background="{StaticResource CorFundoCinza}" Visibility="Collapsed">
                            <TextBlock Name="lblIgnorados" FontSize="11" Foreground="{StaticResource CorTextoSecundario}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== CONTEÚDO ===== -->
        <StackPanel Grid.Row="1" Margin="22,18,22,6">

            <!-- 1. Segmentos (só quando algum vídeo tem cortes) -->
            <StackPanel Name="pnlSegmentos" Margin="0,0,0,18">
                <TextBlock Text="Segmentos" Style="{StaticResource TituloSecao}"/>
                <TextBlock Text="Como os trechos marcados viram arquivos." Style="{StaticResource DescSecao}"/>
                <UniformGrid Columns="2">
                    <RadioButton Name="rbSeparados" GroupName="Segmentos" Style="{StaticResource OpcaoCartao}" Tag="&#xE8A9;" Margin="0,0,5,0" IsChecked="True" Checked="Opcao_Changed">
                        <StackPanel>
                            <TextBlock Text="Um vídeo por segmento" Style="{StaticResource TituloOpcao}"/>
                            <TextBlock Text="Cada trecho vira um arquivo." Style="{StaticResource DescOpcao}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Name="rbUnico" GroupName="Segmentos" Style="{StaticResource OpcaoCartao}" Tag="&#xE71B;" Margin="5,0,0,0" Checked="Opcao_Changed">
                        <StackPanel>
                            <TextBlock Text="Juntar em um vídeo" Style="{StaticResource TituloOpcao}"/>
                            <TextBlock Text="Une os trechos e corta o resto." Style="{StaticResource DescOpcao}"/>
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
            </StackPanel>

            <!-- 2. Destino -->
            <TextBlock Text="Salvar em" Style="{StaticResource TituloSecao}"/>
            <TextBlock Text="Onde os arquivos convertidos serão gravados." Style="{StaticResource DescSecao}"/>
            <RadioButton Name="rbPastaOriginal" GroupName="Destino" Style="{StaticResource OpcaoCartao}" Tag="&#xE8B7;" Checked="Opcao_Changed">
                <StackPanel>
                    <TextBlock Text="Mesma pasta do original" Style="{StaticResource TituloOpcao}"/>
                    <TextBlock Text="Recebe o sufixo _editado, que sai se o original for excluído." Style="{StaticResource DescOpcao}"/>
                </StackPanel>
            </RadioButton>

            <!-- Sub-opção da "Mesma pasta": recuada e ligada ao cartão de cima por uma linha -->
            <Grid Name="pnlExcluir" Margin="28,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="2" Background="{StaticResource CorBordaForte}" Margin="0,0,12,0"/>
                <Border Name="bdrExcluir" Grid.Column="1" Background="White" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,6,0,0">
                    <StackPanel>
                        <CheckBox Name="chkExcluirOriginal" VerticalContentAlignment="Center" Checked="Opcao_Changed" Unchecked="Opcao_Changed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icone}" Text="&#xE7BA;" FontSize="12" Foreground="{StaticResource CorVermelho}" Margin="0,0,6,0"/>
                                <TextBlock Text="Excluir o vídeo original depois" Foreground="{StaticResource CorVermelho}" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Name="lblExcluirDica" Style="{StaticResource DescOpcao}" Margin="20,3,0,0" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>

            <RadioButton Name="rbOutraPasta" GroupName="Destino" Style="{StaticResource OpcaoCartao}" Tag="&#xE838;" Margin="0,8,0,0" Checked="Opcao_Changed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Outra pasta" Style="{StaticResource TituloOpcao}"/>
                        <TextBlock Name="lblPastaDestino" Text="Nenhuma pasta escolhida" Style="{StaticResource DescOpcao}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Escolher…" Style="{StaticResource BotaoArredondado}" Foreground="{DynamicResource CorDestaqueTexto}" Padding="10,5" Margin="10,0,0,0"
                            VerticalAlignment="Center" Click="BtnEscolherPasta_Click"/>
                </Grid>
            </RadioButton>

            <!-- Sub-opção da "Outra pasta": cria uma subpasta com nome padronizado dentro da pasta escolhida (opcional) -->
            <Grid Name="pnlPadronizada" Margin="28,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="2" Background="{StaticResource CorBordaForte}" Margin="0,0,12,0"/>
                <Border Name="bdrPadronizada" Grid.Column="1" Background="White" BorderBrush="{StaticResource CorBorda}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,6,0,0">
                    <StackPanel>
                        <!-- Liga/desliga: há exportações em que a subpasta não é usada -->
                        <CheckBox Name="chkPadronizada" Style="{StaticResource Interruptor}" Checked="Opcao_Changed" Unchecked="Opcao_Changed">
                            <StackPanel>
                                <TextBlock Text="Criar subpasta com nome padronizado" FontWeight="SemiBold" FontSize="12.5"/>
                                <TextBlock Name="lblPadronizadaDesc" FontSize="11" Foreground="{StaticResource CorTextoSecundario}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </CheckBox>

                        <StackPanel Name="pnlCamposPadronizada" Margin="0,12,0,0">
                            <!-- Quem: cliente e local -->
                            <TextBlock Text="CLIENTE" Style="{StaticResource RotuloCampo}"/>
                            <TextBox Name="txtCliente" Style="{StaticResource Campo}" Tag="Nome do cliente" TextChanged="Campo_TextChanged"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="72"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="CIDADE" Style="{StaticResource RotuloCampo}"/>
                                    <TextBox Name="txtCidade" Style="{StaticResource Campo}" Tag="Nome da cidade" TextChanged="Campo_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="UF" Style="{StaticResource RotuloCampo}"/>
                                    <TextBox Name="txtEstado" Style="{StaticResource Campo}" Tag="UF" MaxLength="2" CharacterCasing="Upper" TextChanged="Campo_TextChanged"/>
                                </StackPanel>
                            </Grid>

                            <!-- Ensaio: velocidade e data -->
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="VELOCIDADE" Style="{StaticResource RotuloCampo}"/>
                                    <TextBox Name="txtVelocidade" Style="{StaticResource Campo}" Tag="Como deve aparecer no nome" TextChanged="Campo_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="DATA" Style="{StaticResource RotuloCampo}"/>
                                    <DatePicker Name="dpData" Height="30" VerticalContentAlignment="Center" BorderBrush="{StaticResource CorBordaForte}"
                                                SelectedDateFormat="Short" SelectedDateChanged="Campo_DataChanged"/>
                                </StackPanel>
                            </Grid>

                            <!-- Prévia do nome final (ou o que falta preencher) -->
                            <Border Name="bdrPrevia" Margin="0,12,0,0" CornerRadius="6" Padding="10,7" Background="{StaticResource CorFundoCinza}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Name="icoPrevia" Style="{StaticResource Icone}" Text="&#xE8B7;" FontSize="13" Foreground="{StaticResource CorTextoSecundario}"
                                               Margin="0,0,8,0" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Name="lblPreviaTitulo" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource CorTextoSecundario}"/>
                                        <TextBlock Name="lblNomePasta" FontSize="11.5" Foreground="{StaticResource CorTexto}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Ajuste secundário: desempenho em uma linha só -->
            <Border Margin="0,18,0,0" Padding="0,14,0,0" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Desempenho" FontSize="12.5" FontWeight="SemiBold"/>
                        <TextBlock Name="lblDescDesempenho" FontSize="11" Foreground="{StaticResource CorTextoSecundario}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource CorBotaoFundo}" CornerRadius="8" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Name="rbAlto" GroupName="Desempenho" Style="{StaticResource Segmento}" Tag="&#xE945;" Content="Alto" IsChecked="True" Checked="Opcao_Changed"/>
                            <RadioButton Name="rbEconomico" GroupName="Desempenho" Style="{StaticResource Segmento}" Tag="&#xEC48;" Content="Econômico" Checked="Opcao_Changed"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ===== RODAPÉ: resumo da escolha + ações ===== -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource CorBorda}" BorderThickness="0,1,0,0" Padding="22,14" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblRodape" FontSize="11" Foreground="{StaticResource CorTextoSecundario}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                <Button Grid.Column="1" Content="Cancelar" Style="{StaticResource BotaoArredondado}" Padding="16,8" FontSize="13" Margin="0,0,8,0"
                        IsCancel="True" Click="BtnCancelar_Click"/>
                <Button Grid.Column="2" Name="btnExportar" Content="Exportar" Tag="&#xE8AB;" Style="{StaticResource BotaoPrimario}" Padding="18,8" FontSize="13"
                        IsDefault="True" Click="BtnExportar_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
