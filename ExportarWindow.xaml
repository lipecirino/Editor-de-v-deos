<Window x:Class="ExportarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportar"
        Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FFF5F5F7"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextElement.Foreground="#FF1D1D1F">

    <Window.Resources>
        <!-- NÍVEL 1 – decisão principal: cartão grande com ícone, título e descrição -->
        <Style x:Key="OpcaoCartao" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="White" BorderBrush="#FFE5E5EA" BorderThickness="1.5" CornerRadius="10" Padding="12,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="icoFundo" Width="34" Height="34" CornerRadius="8" Background="#FFF2F2F7" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ico" Style="{StaticResource Icone}" Text="{TemplateBinding Tag}" FontSize="16"
                                               Foreground="#FF86868B" HorizontalAlignment="Center"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                <Grid Grid.Column="2" Width="18" Height="18" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="anel" Stroke="#FFC7C7CC" StrokeThickness="1.5"/>
                                    <Ellipse x:Name="ponto" Fill="#FF007AFF" Visibility="Collapsed"/>
                                    <TextBlock x:Name="check" Style="{StaticResource Icone}" Text="&#xE73E;" FontSize="10" Foreground="White"
                                               HorizontalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#FFC7C7CC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#FF007AFF"/>
                                <Setter TargetName="b" Property="Background" Value="#FFF5F9FF"/>
                                <Setter TargetName="icoFundo" Property="Background" Value="#FF007AFF"/>
                                <Setter TargetName="ico" Property="Foreground" Value="White"/>
                                <Setter TargetName="anel" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ponto" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NÍVEL 2 – ajuste secundário: controle segmentado compacto -->
        <Style x:Key="Segmento" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="12,5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="ico" Style="{StaticResource Icone}" Text="{TemplateBinding Tag}" FontSize="12" Foreground="#FF86868B" Margin="0,0,6,0"/>
                                <ContentPresenter x:Name="txt" VerticalAlignment="Center" TextElement.Foreground="#FF86868B"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="White"/>
                                <Setter TargetName="b" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.12" Direction="270"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="ico" Property="Foreground" Value="#FF007AFF"/>
                                <Setter TargetName="txt" Property="TextElement.Foreground" Value="#FF1D1D1F"/>
                                <Setter TargetName="txt" Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Títulos: seção (nível 1) e texto de apoio -->
        <Style x:Key="TituloSecao" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF1D1D1F"/>
        </Style>
        <Style x:Key="DescSecao" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#FF86868B"/>
            <Setter Property="Margin" Value="0,1,0,8"/>
        </Style>
        <Style x:Key="TituloOpcao" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF1D1D1F"/>
        </Style>
        <Style x:Key="DescOpcao" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#FF86868B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== CABEÇALHO: o que vai acontecer ===== -->
        <Border Grid.Row="0" Background="White" BorderBrush="#FFE5E5EA" BorderThickness="0,0,0,1" Padding="22,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="11" Background="#FF007AFF" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Icone}" Text="&#xE8AB;" FontSize="20" Foreground="White" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Exportar vídeos" FontSize="20" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Border Style="{StaticResource Chip}" Background="#FFE5F1FF">
                            <TextBlock Name="lblQtdVideos" FontSize="11" FontWeight="SemiBold" Foreground="#FF007AFF"/>
                        </Border>
                        <Border Style="{StaticResource Chip}" Background="#FFF2F2F7">
                            <TextBlock Text="MP4 · H.264" FontSize="11" Foreground="#FF86868B"/>
                        </Border>
                        <Border Name="chipIgnorados" Style="{StaticResource Chip}" Background="#FFF2F2F7" Visibility="Collapsed">
                            <TextBlock Name="lblIgnorados" FontSize="11" Foreground="#FF86868B"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== CONTEÚDO ===== -->
        <StackPanel Grid.Row="1" Margin="22,18,22,6">

            <!-- 1. Segmentos (só quando algum vídeo tem cortes) -->
            <StackPanel Name="pnlSegmentos" Margin="0,0,0,18">
                <TextBlock Text="Segmentos" Style="{StaticResource TituloSecao}"/>
                <TextBlock Text="Como os trechos marcados viram arquivos." Style="{StaticResource DescSecao}"/>
                <UniformGrid Columns="2">
                    <RadioButton Name="rbSeparados" GroupName="Segmentos" Style="{StaticResource OpcaoCartao}" Tag="&#xE8A9;" Margin="0,0,5,0" IsChecked="True" Checked="Opcao_Changed">
                        <StackPanel>
                            <TextBlock Text="Um vídeo por segmento" Style="{StaticResource TituloOpcao}"/>
                            <TextBlock Text="Cada trecho vira um arquivo." Style="{StaticResource DescOpcao}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Name="rbUnico" GroupName="Segmentos" Style="{StaticResource OpcaoCartao}" Tag="&#xE71B;" Margin="5,0,0,0" Checked="Opcao_Changed">
                        <StackPanel>
                            <TextBlock Text="Juntar em um vídeo" Style="{StaticResource TituloOpcao}"/>
                            <TextBlock Text="Une os trechos e corta o resto." Style="{StaticResource DescOpcao}"/>
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
            </StackPanel>

            <!-- 2. Destino -->
            <TextBlock Text="Salvar em" Style="{StaticResource TituloSecao}"/>
            <TextBlock Text="Onde os arquivos convertidos serão gravados." Style="{StaticResource DescSecao}"/>
            <RadioButton Name="rbPastaOriginal" GroupName="Destino" Style="{StaticResource OpcaoCartao}" Tag="&#xE8B7;" Checked="Opcao_Changed">
                <StackPanel>
                    <TextBlock Text="Mesma pasta do original" Style="{StaticResource TituloOpcao}"/>
                    <TextBlock Text="O arquivo novo recebe o sufixo _editado." Style="{StaticResource DescOpcao}"/>
                </StackPanel>
            </RadioButton>

            <!-- Sub-opção da "Mesma pasta": recuada e ligada ao cartão de cima por uma linha -->
            <Grid Name="pnlExcluir" Margin="28,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="2" Background="#FFD1D1D6" Margin="0,0,12,0"/>
                <Border Name="bdrExcluir" Grid.Column="1" Background="White" BorderBrush="#FFE5E5EA" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,6,0,0">
                    <StackPanel>
                        <CheckBox Name="chkExcluirOriginal" VerticalContentAlignment="Center" Checked="Opcao_Changed" Unchecked="Opcao_Changed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icone}" Text="&#xE7BA;" FontSize="12" Foreground="#FFFF3B30" Margin="0,0,6,0"/>
                                <TextBlock Text="Excluir o vídeo original depois" Foreground="#FFFF3B30" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Name="lblExcluirDica" Style="{StaticResource DescOpcao}" Margin="20,3,0,0" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>

            <RadioButton Name="rbOutraPasta" GroupName="Destino" Style="{StaticResource OpcaoCartao}" Tag="&#xE838;" Margin="0,8,0,0" Checked="Opcao_Changed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Outra pasta" Style="{StaticResource TituloOpcao}"/>
                        <TextBlock Name="lblPastaDestino" Text="Nenhuma pasta escolhida" Style="{StaticResource DescOpcao}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Escolher…" Style="{StaticResource BotaoArredondado}" Padding="10,5" Margin="10,0,0,0"
                            VerticalAlignment="Center" Click="BtnEscolherPasta_Click"/>
                </Grid>
            </RadioButton>

            <!-- 3. Ajuste secundário: desempenho em uma linha só -->
            <Border Margin="0,18,0,0" Padding="0,14,0,0" BorderBrush="#FFE5E5EA" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Desempenho" FontSize="12.5" FontWeight="SemiBold"/>
                        <TextBlock Name="lblDescDesempenho" FontSize="11" Foreground="#FF86868B" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#FFE9E9EE" CornerRadius="8" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Name="rbAlto" GroupName="Desempenho" Style="{StaticResource Segmento}" Tag="&#xE945;" Content="Alto" IsChecked="True" Checked="Opcao_Changed"/>
                            <RadioButton Name="rbEconomico" GroupName="Desempenho" Style="{StaticResource Segmento}" Tag="&#xEC48;" Content="Econômico" Checked="Opcao_Changed"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ===== RODAPÉ: resumo da escolha + ações ===== -->
        <Border Grid.Row="2" Background="White" BorderBrush="#FFE5E5EA" BorderThickness="0,1,0,0" Padding="22,14" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Name="lblRodape" FontSize="11" Foreground="#FF86868B" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                <Button Grid.Column="1" Content="Cancelar" Style="{StaticResource BotaoArredondado}" Padding="16,8" FontSize="13" Margin="0,0,8,0"
                        IsCancel="True" Click="BtnCancelar_Click"/>
                <Button Grid.Column="2" Name="btnExportar" Content="Exportar" Tag="&#xE8AB;" Style="{StaticResource BotaoPrimario}" Padding="18,8" FontSize="13"
                        IsDefault="True" Click="BtnExportar_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
