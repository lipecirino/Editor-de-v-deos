<Window x:Class="ConfirmacaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextElement.Foreground="#FF1D1D1F">
    <!-- Confirmação no estilo do app: ícone, título, explicação e duas ações -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="22,22,22,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Name="bdrIcone" Width="44" Height="44" CornerRadius="22" Background="#FFFFEBEA" Margin="0,0,14,0" VerticalAlignment="Top">
                <TextBlock Name="icoConfirmacao" Style="{StaticResource Icone}" Text="&#xE7BA;" FontSize="20" Foreground="#FFFF3B30" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Name="lblTitulo" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                    <TextBlock Name="lblMensagem" FontSize="12.5" Foreground="#FF6E6E73" TextWrapping="Wrap" LineHeight="18"/>
                </ScrollViewer>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#FFF5F5F7" BorderBrush="#FFE5E5EA" BorderThickness="0,1,0,0" Padding="22,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="btnNao" Style="{StaticResource BotaoArredondado}" Padding="16,8" FontSize="13" Margin="0,0,8,0"
                        IsCancel="True" IsDefault="True" Click="BtnNao_Click"/>
                <Button Name="btnSim" Style="{StaticResource BotaoPrimario}" Padding="16,8" FontSize="13" Click="BtnSim_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
